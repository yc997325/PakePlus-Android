{"name":"aefcafdfbcc","url":"index.html (等资源+1)","showName":"邦手定位","appid":"com.aefcafdfbcc.pakeplus","icon":"","iconPath":"","iconRound":true,"state":true,"single":true,"injectJq":true,"tauriApi":false,"devbug":true,"version":"0.0.1","preview":"Android","platform":["1-1"],"width":412,"height":915,"desc":"","jsFile":[],"filterCss":"","customJs":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>邦手定位</title>\n<script src=\"https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js\"></script>\n<style>\n*{margin:0;padding:0;box-sizing:border-box;font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;}\nbody{\n    background:#ffffff;\n    text-align:center;\n    padding:40px 24px;\n}\n.title{\n    font-size:22px;\n    color:#222;\n    margin-bottom:32px;\n}\n#qrcanvas{\n    width:80%;\n    max-width:320px;\n    margin:0 auto 32px;\n}\n.info-wrap{\n    text-align:left;\n    width:80%;\n    max-width:320px;\n    margin:0 auto 48px;\n    font-size:18px;\n    color:#333;\n    line-height:2.4;\n}\n.info-item{\n    margin:4px 0;\n}\n#btnRelocate{\n    width:80%;\n    max-width:320px;\n    background-color:#24bc57;\n    color:#fff;\n    border:none;\n    border-radius:12px;\n    font-size:19px;\n    padding:16px 0;\n}\n#btnRelocate:active{\n    background:#1fa84c;\n}\n</style>\n</head>\n<body>\n<div class=\"title\">邦手定位</div>\n<canvas id=\"qrcanvas\"></canvas>\n<div class=\"info-wrap\">\n    <div class=\"info-item\">当前经度：<span id=\"lngVal\"></span></div>\n    <div class=\"info-item\">当前纬度：<span id=\"latVal\"></span></div>\n    <div class=\"info-item\">定位时间：<span id=\"timeVal\"></span></div>\n</div>\n<button id=\"btnRelocate\">重新定位</button>\n\n<script>\nconst $ = s => document.querySelector(s);\nfunction getTimeStr(){\n    const d = new Date();\n    const y = d.getFullYear();\n    const m = String(d.getMonth()+1).padStart(2, '0');\n    const day = String(d.getDate()).padStart(2, '0');\n    const h = String(d.getHours()).padStart(2, '0');\n    const mi = String(d.getMinutes()).padStart(2, '0');\n    const sec = String(d.getSeconds()).padStart(2, '0');\n    return `${y}/${m}/${day} ${h}:${mi}:${sec}`;\n}\n\nasync function startLocate(){\n    $(\"#btnRelocate\").innerText = \"定位中...\";\n    navigator.geolocation.getCurrentPosition(pos=>{\n        const lat = pos.coords.latitude;\n        const lng = pos.coords.longitude;\n        const t = getTimeStr();\n        $(\"#latVal\").innerText = lat;\n        $(\"#lngVal\").innerText = lng;\n        $(\"#timeVal\").innerText = t;\n        //邦手标准JSON\n        const jsonText = `{\"longitude\":\"${lng}\",\"latitude\":\"${lat}\",\"time\":\"${t}\",\"type\":\"01\"}`;\n        QRCode.toCanvas($(\"#qrcanvas\"), jsonText, {width:320, margin:2}, err=>{\n            $(\"#btnRelocate\").innerText = \"重新定位\";\n        })\n    }, err=>{\n        alert(\"定位失败，请检查：GPS开关、浏览器定位权限、虚拟定位是否开启\");\n        $(\"#btnRelocate\").innerText = \"重新定位\";\n    },{\n        enableHighAccuracy:true,\n        timeout:12000,\n        maximumAge:0\n    })\n}\n$(\"#btnRelocate\").onclick = startLocate;\n</script>\n</body>\n</html>\n","isHtml":true,"htmlPath":"C:\\Users\\99732\\Desktop\\新建文件夹","htmlFiles":[],"prefix":"","pcRepo":"PakePlus","iosRepo":"PakePlus-iOS","androidRepo":"PakePlus-Android","win7Repo":"","versionStr":"web10","more":{"windows":{"label":"aefcafdfbcc","title":"邦手定位","url":"index.html (等资源+1)","userAgent":"Mozilla/5.0 (Linux; Android 14; Pixel 6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36","width":412,"height":915,"theme":null,"resizable":true,"fullscreen":false,"maximized":false,"minWidth":400,"minHeight":300,"maxWidth":1920,"maxHeight":1080,"decorations":true,"transparent":false,"titleBarStyle":"Visible","visible":true,"focus":true,"closable":true,"minimizable":true,"maximizable":true,"alwaysOnTop":false,"alway